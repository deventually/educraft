# LimeOnIt environment configuration
# Copy this file to `.env` and fill in what you use. Never commit `.env`. Development
# (`npm run dev`) and the Docker image (`docker compose up`, see docs/installatie-docker.md)
# read the same variables.

# --- Security (required in production) -------------------------------------------
# Signs the login cookie: 32+ random characters. The app refuses to start in production
# with the dev default. Make one with:  openssl rand -base64 48  (then remove the leading #).
# SESSION_SECRET=
# The public address of this instance (no trailing slash). Only the command-line scripts
# use it, to print links (npm run invite, npm run create-admin).
# APP_ORIGIN=http://localhost:3000

# --- AI providers ---------------------------------------------------------------
# The providers and models themselves live in config/models.json (see config/README.md).
# Here go only their keys (and, if needed, another address). A provider shows as
# "Gekoppeld" on Beheer → Tools en modellen once its key is set; restart after a change.
# Each *_BASE_URL is optional: leave it unset to use the provider's own address from
# config/models.json; set it for a proxy, another region or a gateway.

# Anthropic (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# OpenAI (ChatGPT) — https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google (Gemini) — https://aistudio.google.com/apikey
# GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Mistral — https://console.mistral.ai/api-keys
# MISTRAL_API_KEY=
# MISTRAL_BASE_URL=https://api.mistral.ai/v1

# MiniMax — https://platform.minimax.io/
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimax.io/v1

# OpenCode Zen — https://opencode.ai/zen
# OPENCODE_ZEN_API_KEY=
# OPENCODE_ZEN_BASE_URL=https://opencode.ai/inference/openai/v1

# OpenRouter — https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Your own endpoint that speaks the OpenAI API (GLM, DeepSeek, vLLM, …). The address
# is required; the key is optional for a keyless self-hosted server.
# OPENAI_COMPAT_BASE_URL=https://open.bigmodel.cn/api/paas/v4   # example: GLM (Zhipu)
# OPENAI_COMPAT_API_KEY=

# Local servers (no key; models are found at runtime). Development only, like the CLI
# agents (Claude Code, opencode, Codex, Gemini CLI): npm start and Docker do not offer them.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# --- Database ------------------------------------------------------------------
# Local SQLite file (relative to the project root). docker-compose.yml overrides this with
# file:/data/limeonit.db on the data volume.
DATABASE_URL=file:./data/limeonit.db
# Where the migrations live; the Docker image sets /app/drizzle.
# MIGRATIONS_DIR=./drizzle

# --- Limits --------------------------------------------------------------------
# Per client: requests per minute and requests at the same time to the AI.
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_CONCURRENT=3
# Per teacher per day (admins are exempt): AI requests and output tokens.
# DAILY_REQUEST_LIMIT=50
# DAILY_OUTPUT_TOKEN_LIMIT=200000

# --- Docker only (read by docker-compose.yml) ------------------------------------
# Host port for the app (default 3000).
# LIMEONIT_PORT=3000
# A host folder for the database instead of the named volume (must be writable by uid 1000).
# LIMEONIT_DATA=/srv/limeonit

# --- Evals (developers only) ------------------------------------------------------
# A private folder with extra eval cases that must not go into the public repo.
# EVALS_PRIVATE_DIR=
