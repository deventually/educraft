# LimeOnIt environment configuration
# Copy this file to `.env` and fill in your keys. Development (`npm run dev`) and the Docker
# image (`docker compose up`, see docs/installatie-docker.md) read the same variables.

# --- Security (required in production) ---
# Signs the session cookie: 32+ random characters. The app refuses to start in production with
# the dev default. Make one with:  openssl rand -base64 48  (then remove the leading #).
# SESSION_SECRET=
# The public address of this instance, used in invite links (no trailing slash).
# APP_ORIGIN=http://localhost:3000

# --- AI providers ---
# Anthropic Claude is wired first. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional (later phases): native OpenAI / Google / Mistral SDKs
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# MISTRAL_API_KEY=

# Any frontier or self-hosted model that speaks the OpenAI API — one endpoint
# reaches ChatGPT, Gemini, Mistral, GLM, DeepSeek, OpenRouter, vLLM, … Reference a
# model with a "compat::<model>" id (e.g. the summary sweep: npm run sweep --
# --model "compat::glm-4-plus"). Key is optional for a keyless self-hosted endpoint.
# OPENAI_COMPAT_BASE_URL=https://open.bigmodel.cn/api/paas/v4   # example: GLM (Zhipu)
# OPENAI_COMPAT_API_KEY=

# Local OpenAI-compatible servers (no key needed; discovered at runtime).
# Development only: a production process (npm start, Docker) does not offer local models.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# --- Database ---
# Local SQLite file (relative to project root). docker-compose.yml overrides this with
# file:/data/limeonit.db on the data volume.
DATABASE_URL=file:./data/limeonit.db
# Where the migrations live; the Docker image sets /app/drizzle.
# MIGRATIONS_DIR=./drizzle

# --- Limits (optional; defaults shown) ---
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_CONCURRENT=3
# DAILY_REQUEST_LIMIT=50
# DAILY_OUTPUT_TOKEN_LIMIT=200000

# --- Docker only (read by docker-compose.yml) ---
# Host port for the app (default 3000).
# LIMEONIT_PORT=3000
# A host folder for the database instead of the named volume (must be writable by uid 1000).
# LIMEONIT_DATA=/srv/limeonit
