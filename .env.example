# LimeOnIt environment configuration
# Copy this file to `.env` and fill in your keys.

# --- AI providers ---
# Anthropic Claude is wired first. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional (later phases): OpenAI and Google Gemini
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# --- Database ---
# Local SQLite file (relative to project root).
DATABASE_URL=file:./data/limeonit.db
