# LimeOnIt environment configuration
# Copy this file to `.env` and fill in what you use. Never commit `.env`. Development
# (`npm run dev`) and the Docker image (`docker compose up`, see docs/installatie-docker.md)
# read the same variables.

# --- Security (required in production) -------------------------------------------
# Signs the login cookie: 32+ random characters. The app refuses to start in production
# with the dev default. Make one with:  openssl rand -base64 48  (then remove the leading #).
# SESSION_SECRET=
# The public address of this instance (no trailing slash). Only the command-line scripts
# use it, to print links (npm run invite, npm run create-admin).
# APP_ORIGIN=http://localhost:3000

# --- AI providers ---------------------------------------------------------------
# The providers and models themselves live in config/models.json (see config/README.md).
# Here go only their secret keys; their addresses are in config/models.json. A provider
# shows as "Gekoppeld" on Beheer → Tools en modellen once its key is set; restart after
# a change. A new provider: add it to config/models.json and its key here.

# Anthropic (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI (ChatGPT) — https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# Google (Gemini) — https://aistudio.google.com/apikey
# GOOGLE_GENERATIVE_AI_API_KEY=

# Mistral — https://console.mistral.ai/api-keys
# MISTRAL_API_KEY=

# MiniMax — https://platform.minimax.io/
# MINIMAX_API_KEY=

# OpenCode Zen — https://opencode.ai/zen
# OPENCODE_ZEN_API_KEY=

# OpenRouter — https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Your own endpoint that speaks the OpenAI API (GLM, DeepSeek, vLLM, …), kept here for
# existing setups. A new one is easier as its own provider in config/models.json.
# The key is optional for a keyless self-hosted server.
# OPENAI_COMPAT_BASE_URL=https://open.bigmodel.cn/api/paas/v4   # example: GLM (Zhipu)
# OPENAI_COMPAT_API_KEY=

# Local servers (no key; models are found at runtime). Development only, like the CLI
# agents (Claude Code, opencode, Codex, Gemini CLI): npm start and Docker do not offer them.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Ollama's context window in tokens (default 32768, enough for a long document). Lower it
# on a computer with little memory; a too small window silently cuts off long prompts.
# OLLAMA_NUM_CTX=32768

# --- Dictation (speech to text) ---------------------------------------------------
# A Whisper server that speaks OpenAI's /audio/transcriptions API. Without an address
# there is no dictation button. The audio goes from the browser through LimeOnIt to this
# server; nothing is stored. Pick one:
#   Docker (docker compose --profile speech up -d):
# WHISPER_BASE_URL=http://whisper:8178/v1
#   whisper.cpp on this computer (brew install whisper-cpp, see config/README.md):
# WHISPER_BASE_URL=http://127.0.0.1:8178/v1
#   OpenAI in the cloud (audio leaves the school; check the AVG first):
# WHISPER_BASE_URL=https://api.openai.com/v1
# WHISPER_API_KEY=
# WHISPER_MODEL=large-v3-turbo-q5_0   # Docker only: the model the whisper service downloads

# --- Database ------------------------------------------------------------------
# Local SQLite file (relative to the project root). docker-compose.yml overrides this with
# file:/data/limeonit.db on the data volume.
DATABASE_URL=file:./data/limeonit.db
# Where the migrations live; the Docker image sets /app/drizzle.
# MIGRATIONS_DIR=./drizzle

# --- Limits --------------------------------------------------------------------
# Per client: requests per minute and requests at the same time to the AI.
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_CONCURRENT=3
# Per teacher per day (admins are exempt): AI requests and output tokens.
# DAILY_REQUEST_LIMIT=50
# DAILY_OUTPUT_TOKEN_LIMIT=200000

# --- Docker only (read by docker-compose.yml) ------------------------------------
# Host port for the app (default 3000).
# LIMEONIT_PORT=3000
# A host folder for the database instead of the named volume (must be writable by uid 1000).
# LIMEONIT_DATA=/srv/limeonit

# --- Evals (developers only) ------------------------------------------------------
# A private folder with extra eval cases that must not go into the public repo.
# EVALS_PRIVATE_DIR=
