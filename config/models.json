{
  "default": "claude-sonnet-5-5",
  "providers": [
    {
      "id": "anthropic",
      "name": "Anthropic (Claude)",
      "api": "anthropic",
      "baseURL": "https://api.anthropic.com/v1",
      "keyEnv": "ANTHROPIC_API_KEY",
      "modelsUrl": "https://docs.anthropic.com/en/docs/about-claude/models",
      "example": "claude-haiku-5-5",
      "cache": "markers"
    },
    {
      "id": "openai",
      "name": "OpenAI (ChatGPT)",
      "api": "openai-compatible",
      "baseURL": "https://api.openai.com/v1",
      "keyEnv": "OPENAI_API_KEY",
      "modelsUrl": "https://developers.openai.com/api/docs/models",
      "example": "gpt-6.1-sol",
      "cache": { "key": "prompt_cache_key" }
    },
    {
      "id": "google",
      "name": "Google (Gemini)",
      "api": "openai-compatible",
      "baseURL": "https://generativelanguage.googleapis.com/v1beta/openai/",
      "keyEnv": "GOOGLE_GENERATIVE_AI_API_KEY",
      "modelsUrl": "https://ai.google.dev/gemini-api/docs/models",
      "example": "gemini-4-argon",
      "cache": "auto"
    },
    {
      "id": "mistral",
      "name": "Mistral",
      "api": "openai-compatible",
      "baseURL": "https://api.mistral.ai/v1",
      "keyEnv": "MISTRAL_API_KEY",
      "modelsUrl": "https://docs.mistral.ai/getting-started/models/",
      "example": "mistral-large-4",
      "cache": { "key": "prompt_cache_key" }
    },
    {
      "id": "minimax",
      "name": "MiniMax",
      "api": "openai-compatible",
      "baseURL": "https://api.minimax.io/v1",
      "keyEnv": "MINIMAX_API_KEY",
      "modelsUrl": "https://platform.minimax.io/docs/guides/text-chat",
      "example": "MiniMax-M3",
      "cache": "auto"
    },
    {
      "id": "zai",
      "name": "Z.AI (GLM)",
      "api": "openai-compatible",
      "baseURL": "https://api.z.ai/api/paas/v4",
      "keyEnv": "ZAI_API_KEY",
      "modelsUrl": "https://docs.z.ai/guides/overview/overview",
      "example": "glm-5.3",
      "cache": "auto"
    },
    {
      "id": "xai",
      "name": "xAI (Grok)",
      "api": "openai-compatible",
      "baseURL": "https://api.x.ai/v1",
      "keyEnv": "XAI_API_KEY",
      "modelsUrl": "https://docs.x.ai/developers/models",
      "example": "grok-4.7",
      "cache": "auto"
    },
    {
      "id": "qwen",
      "name": "Alibaba (Qwen)",
      "api": "openai-compatible",
      "baseURLEnv": "QWEN_BASE_URL",
      "keyEnv": "QWEN_API_KEY",
      "modelsUrl": "https://www.alibabacloud.com/help/en/model-studio/compatibility-of-openai-with-dashscope",
      "example": "qwen3.8-max",
      "cache": "auto"
    },
    {
      "id": "together",
      "name": "Together AI (Meta Muse)",
      "api": "openai-compatible",
      "baseURL": "https://api.together.xyz/v1",
      "keyEnv": "TOGETHER_API_KEY",
      "modelsUrl": "https://docs.together.ai/docs/serverless-models",
      "example": "meta-models/Muse-Spark-Open-816B-A42B",
      "cache": "auto"
    },
    {
      "id": "opencode-zen",
      "name": "OpenCode Zen",
      "api": "openai-compatible",
      "baseURL": "https://opencode.ai/inference/openai/v1",
      "keyEnv": "OPENCODE_ZEN_API_KEY",
      "modelsUrl": "https://opencode.ai/docs/zen/",
      "example": "kimi-k3",
      "cache": "auto"
    },
    {
      "id": "openrouter",
      "name": "OpenRouter",
      "api": "openai-compatible",
      "baseURL": "https://openrouter.ai/api/v1",
      "keyEnv": "OPENROUTER_API_KEY",
      "modelsUrl": "https://openrouter.ai/models",
      "example": "openrouter/auto",
      "cache": { "key": "session_id" }
    },
    {
      "id": "openai-compat",
      "name": {
        "nl": "Eigen OpenAI-compatibel adres",
        "en": "Own OpenAI-compatible endpoint"
      },
      "api": "openai-compatible",
      "baseURLEnv": "OPENAI_COMPAT_BASE_URL",
      "keyEnv": "OPENAI_COMPAT_API_KEY",
      "keyOptional": true,
      "example": "glm-4-plus",
      "cache": "auto"
    },
    {
      "id": "whisper",
      "name": {
        "nl": "Spraakherkenning (Whisper)",
        "en": "Speech recognition (Whisper)"
      },
      "api": "openai-compatible",
      "baseURLEnv": "WHISPER_BASE_URL",
      "keyEnv": "WHISPER_API_KEY",
      "keyOptional": true,
      "example": "whisper-1",
      "cache": "auto"
    }
  ],
