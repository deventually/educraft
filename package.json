{
  "name": "limeonit",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build && vite build -c scripts/ops.config.ts",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint --error-on-warnings",
    "lint:fix": "biome lint --write",
    "format": "biome format --write",
    "check": "biome check --error-on-warnings",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx app/server/migrate.ts",
    "db:push": "drizzle-kit push",
    "invite": "tsx scripts/invite.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "set-owner": "tsx scripts/set-owner.ts",
    "eval": "vite-node -c scripts/eval.config.ts scripts/eval.ts",
    "eval:coach": "vite-node -c scripts/eval.config.ts scripts/eval-coach.ts",
    "eval:agents": "vite-node -c scripts/eval.config.ts scripts/eval-agents.ts",
    "eval:proofread": "vite-node -c scripts/eval.config.ts scripts/eval-proofread.ts",
    "eval:import": "vite-node -c scripts/eval.config.ts scripts/eval-import.ts",
    "eval:rehearsal": "vite-node -c scripts/eval.config.ts scripts/eval-rehearsal.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.8",
    "@ai-sdk/openai-compatible": "^3.0.5",
    "@react-router/node": "8.5.1",
    "@react-router/serve": "8.5.1",
    "ai": "^7.0.15",
    "better-sqlite3": "^12.2.0",
    "clsx": "^2.1.1",
    "docx": "9.11.0",
    "drizzle-orm": "^0.45.2",
    "isbot": "^5.1.36",
    "lucide-react": "^0.469.0",
    "mammoth": "^1.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^9.0.1",
    "react-router": "8.5.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^3.0.1",
    "unpdf": "^1.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@biomejs/biome": "^2.4.16",
    "@react-router/dev": "8.5.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.1",
    "happy-dom": "^21.0.4",
    "jszip": "^3.10.2",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.12",
    "vitest-axe": "^0.1.0"
  },
  "volta": {
    "node": "24.14.1"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
