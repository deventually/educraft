{
  "name": "limeonit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build && vite build -c scripts/ops.config.ts",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "biome lint --error-on-warnings",
    "lint:fix": "biome lint --write",
    "format": "biome format --write",
    "check": "biome check --error-on-warnings && npm run knip",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx app/server/migrate.ts",
    "db:push": "drizzle-kit push",
    "invite": "tsx scripts/invite.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "set-owner": "tsx scripts/set-owner.ts",
    "reset-2fa": "tsx scripts/reset-2fa.ts",
    "eval": "vite-node -c scripts/eval.config.ts scripts/eval.ts",
    "eval:coach": "vite-node -c scripts/eval.config.ts scripts/eval-coach.ts",
    "eval:agents": "vite-node -c scripts/eval.config.ts scripts/eval-agents.ts",
    "eval:framework": "vite-node -c scripts/eval.config.ts scripts/eval-framework.ts",
    "eval:proofread": "vite-node -c scripts/eval.config.ts scripts/eval-proofread.ts",
    "eval:import": "vite-node -c scripts/eval.config.ts scripts/eval-import.ts",
    "eval:design": "vite-node -c scripts/eval.config.ts scripts/eval-design.ts",
    "eval:design-assessments": "vite-node -c scripts/eval.config.ts scripts/eval-design-assessments.ts",
    "eval:design-lessons": "vite-node -c scripts/eval.config.ts scripts/eval-design-lessons.ts",
    "eval:rehearsal": "vite-node -c scripts/eval.config.ts scripts/eval-rehearsal.ts",
    "knip": "knip --no-progress",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.99",
    "@ai-sdk/openai-compatible": "^3.0.87",
    "@react-router/node": "8.5.1",
    "@react-router/serve": "8.5.1",
    "ai": "^7.0.166",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "docx": "9.15.3",
    "drizzle-orm": "^0.45.4",
    "isbot": "^5.2.3",
    "jszip": "^3.10.2",
    "lucide-react": "^1.70.0",
    "mammoth": "^1.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "8.5.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^2.1.0",
    "uqr": "0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "^2.6.6",
    "@playwright/test": "1.65.0",
    "@react-router/dev": "8.5.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "^21.0.4",
    "knip": "^6.44.2",
    "oxc-parser": "^0.157.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-node": "^6.0.0",
    "vitest": "^5.1.0",
    "vitest-axe": "^0.1.0"
  },
  "volta": {
    "node": "26.13.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "@stryker-mutator/core": {
      "minimatch": "^11.0.6"
    },
    "playwright-core": "1.65.0",
    "typed-rest-client": {
      "qs": "^6.17.1"
    }
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "fsevents": false
  }
}
