    "@react-router/serve": "7.15.1",
    "ai": "^6.0.193",
    "better-sqlite3": "^12.2.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.2",
    "isbot": "^5.1.36",
    "lucide-react": "^0.469.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^9.0.1",
    "react-router": "7.15.1",
    "remark-gfm": "^4.0.0",
