{
  "permissions": {
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git tag:*)",
      "Bash(git push --tags:*)",
      "Bash(git push origin --tags:*)",
      "Bash(gh release:*)"
    ]
  },
  "extraKnownMarketplaces": {
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      }
    }
  },
  "enabledPlugins": {
    "typesafe@typesafe-ai": true
  }
}
